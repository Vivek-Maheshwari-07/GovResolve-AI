# GovResolve-AI configuration.
# Copy to .env and edit:  cp .env.example .env      (.env is git-ignored: never commit it, never paste keys into chat or issues)
# Check your setup at any time:  make llm-check      (python -m backend.scripts.llm_smoke)

# =====================================================================================================================
# 1. Which language model writes the answers?
# =====================================================================================================================
# ollama  Local models through Ollama. No key, works offline, data stays on the machine. Slow on a CPU (35-80 s per answer).
# groq    Groq's hosted API. Fast (about 10 s) but needs GROQ_API_KEY and sends the question and evidence passages to Groq.
# openai  Any other OpenAI-compatible service (OpenRouter, OpenAI, Together, vLLM, LM Studio): fill LLM_API_* below. (Legacy name: api)
# gemini  Google Gemini (optional, needs `pip install google-genai`).
# auto    The first hosted provider that has a key, then the local model.
# The chosen provider is tried first; the others follow if it is not configured or fails. With nothing reachable the app still
# answers with one verbatim passage and a warning, never with an invented answer. (Legacy name for ollama: local)
LLM_PROVIDER=ollama

# =====================================================================================================================
# 2. Ollama (local)       Install: https://ollama.com      then:  ollama pull qwen3.5:4b  &&  ollama pull bge-m3
# =====================================================================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b          # the model the project was evaluated with; a smaller or larger one works too
OLLAMA_REASONING=none            # thinking models time out on a CPU unless reasoning is off; leave the value empty to omit the option
OLLAMA_TIMEOUT=180               # seconds per call (the first call also loads the model)
OLLAMA_MAX_TOKENS=700            # cap on the answer length; Gujarati costs about 1.5x the tokens of English
OLLAMA_KEEP_ALIVE=30m            # how long Ollama keeps the model in memory after the start-up warm-up

# =====================================================================================================================
# 3. Groq (hosted)        Key: https://console.groq.com/keys      Models: https://console.groq.com/docs/models
# =====================================================================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b   # the model the project tested; availability depends on your key, see `make llm-check`
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=700
GROQ_MAX_RETRIES=2               # retries after a rate limit (429) or a server error, honouring Retry-After
# GROQ_REASONING_EFFORT=low      # low | medium | high, for reasoning models such as gpt-oss. Lower is faster and cheaper.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# =====================================================================================================================
# 4. Other providers (optional)
# =====================================================================================================================
# Any OpenAI-compatible chat endpoint. All three must be set, then use LLM_PROVIDER=openai.
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=
# LLM_API_TIMEOUT=60
# Google Gemini, then use LLM_PROVIDER=gemini.
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# =====================================================================================================================
# 5. Search
# =====================================================================================================================
# Embeddings for the vector index. 'ollama:bge-m3' uses the model served by Ollama. Changing it requires rebuilding the index:
#   python -m backend.scripts.build_squad2_index --corpus data/corpus_v2 --index data/index/chroma
# Optional alternatives: a sentence-transformers name such as BAAI/bge-m3 (pip install -r requirements/optional.txt).
EMBEDDING_MODEL=ollama:bge-m3
CHROMA_PERSIST_DIR=./data/index/chroma
INDEX_BATCH=64                   # chunks per embedding call; bge-m3 on a CPU does about 1.4 chunks per second
OLLAMA_EMBED_TIMEOUT=600

TOP_K_RETRIEVE=20                # candidates from the hybrid search
TOP_K_RERANK=3                   # how many top hits may bring in their amending order. CPU-sized; with Groq 5 is better.
EVIDENCE_CANDIDATES=8            # chunks whose sentences compete for the evidence budget (more than 10 measured worse)
EVIDENCE_CHARS_PER_CHUNK=500
EVIDENCE_MAX_CHARS=1500          # prompt budget; Gujarati counts 1.5x. With Groq: 1200 / 6000 is fine.

# =====================================================================================================================
# 6. Answer behaviour
# =====================================================================================================================
# GOV_ENGINE=squad2 answers through the RAG pipeline (needs a corpus and a search index, see README). The default `retrieval` returns
# the best matching passages only, without a language model (demo mode).
GOV_ENGINE=squad2
# After an answer, a second short model call checks that the cited sentences really answer the question.
# off (default) | warn (keep the answer, add a warning) | refuse (give no answer). Adds a model call per answer.
# ANSWER_CHECK=off
# Gujarati / Gujlish questions are translated to English once (one short model call) and remembered here. Empty value = no file.
# TRANSLATION_CACHE=./data/index/translations.json
# Refuse when every cited order only amends a GR that is not in the collection (default: answer with a warning).
# GOV_BROKEN_CHAIN_REFUSES=1

# =====================================================================================================================
# 7. Server and security
# =====================================================================================================================
# Protects /admin/* and every write to /documents (send the header X-Admin-Token). REQUIRED if the server is reachable by anyone else.
# GOV_ADMIN_TOKEN=change-me-to-a-long-random-string
# Questions per client address per minute (0 = off).
# GOV_QUERY_RATE_PER_MIN=120
# Allowed browser origins, as JSON. The default allows localhost only.
# GOV_CORS_ORIGINS=["https://gr.example.org"]

# =====================================================================================================================
# 8. Data and OCR
# =====================================================================================================================
# GOV_CORPUS_DIR=./data/corpus_v2          # folder of GR-*.json records (default: the synthetic demo fixtures)
# GOV_PDF_EXTRA_DIRS=D:/pdfs;E:/more       # extra folders searched recursively for the source PDFs
GR_PDF_DIR=./data/grs
PROCESSED_DIR=./data/processed
TESSERACT_CMD=tesseract          # full path if it is not on PATH, e.g. C:/Program Files/Tesseract-OCR/tesseract.exe
