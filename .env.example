# GovResolve-AI Environment Configuration
# Copy this to .env and fill in your values

# --- LLM Provider (Agnostic: Cloud Gemini or Local Ollama/vLLM) ---
LLM_PROVIDER=auto       # Options: 'auto' | 'gemini' | 'local'

# Cloud Gemini Settings (used if LLM_PROVIDER is 'gemini' or 'auto')
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local LLM Settings (used if LLM_PROVIDER is 'local' or 'auto' fallback)
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen3.5:4b   # CPU only: about 10 s for a short test, 60 s for a real Gujarati answer
LOCAL_LLM_REASONING=none     # turns off thinking mode; without it qwen3.5 times out
LOCAL_LLM_TIMEOUT=180        # qwen3.5:4b on this CPU needs about 60 s for a Gujarati answer
LOCAL_LLM_MAX_TOKENS=700
LOCAL_LLM_KEEP_ALIVE=30m

# --- Vector Store & Embeddings ---
CHROMA_PERSIST_DIR=./data/index/chroma
# 'ollama:bge-m3' uses the model served by local Ollama (no Hugging Face download).
# Or a sentence-transformers name: 'BAAI/bge-m3', 'intfloat/multilingual-e5-small'
EMBEDDING_MODEL=ollama:bge-m3
INDEX_BATCH=64             # chunks per embedding call; bge-m3 on CPU does about 1.4 chunks/s
OLLAMA_EMBED_TIMEOUT=600

# --- Data Paths ---
GR_PDF_DIR=./data/grs
PROCESSED_DIR=./data/processed

# --- OCR ---
TESSERACT_CMD=tesseract   # full path if not in PATH, e.g. C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Search ---
TOP_K_RETRIEVE=20
TOP_K_RERANK=3             # CPU-sized evidence: the model reads about 30 tokens/s, so every extra passage costs seconds
EVIDENCE_CHARS_PER_CHUNK=500
EVIDENCE_MAX_CHARS=1500    # Gujarati counts 1.5x. Faster still: 1000 / 400 / TOP_K_RERANK=2 (about 10 s less, fewer passages). Cloud model: 1200 / 6000 or remove
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# --- Answer Generation ---
MAX_ANSWER_TOKENS=1500
TEMPERATURE=0.0    # deterministic for citation repeatability

# --- Logging ---
LOG_LEVEL=INFO

# --- Backend (backend/app) ---
# /query engine: 'retrieval' (default, vector hits) or 'squad2' (RAG pipeline: hybrid search + LLM + citation check).
# Settings read the environment, or a .env in the directory you start from; from backend/ run:  GOV_ENGINE=squad2 uvicorn app.main:app
GOV_ENGINE=squad2
